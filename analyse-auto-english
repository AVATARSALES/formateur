<!-- TAB MASTÈRE -->
<!-- ═══════════════════════════════════════════════════════════════════════ -->
<div class="tab-content" id="tab-mastere">
<span class="level-badge level-mastere">Master's level — 9 criteria + verdict</span>
<div class="context-box">
